---
// 全页冰晶飘雪（B1）：单个 canvas 层，低密度六角冰晶缓慢下落
// 位置：z-index -1 —— 在背景渐变/光斑之上、内容与玻璃卡之下（透过磨砂玻璃卡看到朦胧晶体）
// 性能：rAF 驱动、密度按视口面积封顶、标签页隐藏即暂停
// 可访问性：prefers-reduced-motion 时不创建
---

<canvas class="ice-field" id="iceField" aria-hidden="true"></canvas>

<style>
	.ice-field {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		pointer-events: none;
	}
</style>

<script is:inline>
	(() => {
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		const canvas = document.getElementById('iceField');
		if (!canvas) return;
		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		let W = 0, H = 0, dpr = 1;
		let flakes = [];
		let rafId = null;
		let lastT = 0;

		// 鼠标扰动：记录位置与速度
		const mouse = { x: -9999, y: -9999, vx: 0, vy: 0 };
		let lastMX = null, lastMY = null;

		// 冰青色系（不碰紫色）
		const TINTS = [
			'rgba(255,255,255,0.9)',
			'rgba(186,230,253,0.85)',
			'rgba(147,197,253,0.75)',
			'rgba(224,242,254,0.9)'
		];

		const rand = (a, b) => a + Math.random() * (b - a);

		const makeFlake = (fromTop) => {
			// 约 1/7 概率生成一颗醒目的大冰晶
			const big = Math.random() < 0.14;
			return {
				x: rand(0, W),
				y: fromTop ? rand(-60, 0) : rand(0, H),
				r: big ? rand(4.2, 6.4) : rand(1.8, 3.8), // 晶体半径
				spd: big ? rand(22, 46) : rand(14, 38),   // 下落速度 px/s
				swayAmp: rand(8, 26),                     // 横向摇曳幅度
				swayFreq: rand(0.2, 0.6),                 // 摇曳频率
				phase: rand(0, Math.PI * 2),
				rot: rand(0, Math.PI * 2),
				rotSpd: rand(-0.8, 0.8),                  // 自转 rad/s
				tw: rand(0.5, 1),                         // 闪烁相位
				tint: TINTS[(Math.random() * TINTS.length) | 0],
				dx: 0, dy: 0                              // 扰动位移（衰减）
			};
		};

		const resize = () => {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			W = window.innerWidth;
			H = window.innerHeight;
			canvas.width = W * dpr;
			canvas.height = H * dpr;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			const target = Math.min(130, Math.round((W * H) / 11000));
			while (flakes.length < target) flakes.push(makeFlake(false));
			if (flakes.length > target) flakes.length = target;
		};

		// 画一颗六角冰晶（细长六向星形 + 微光）
		const drawFlake = (f, alpha) => {
			ctx.save();
			ctx.translate(f.x + f.dx, f.y + f.dy);
			ctx.rotate(f.rot);
			ctx.globalAlpha = alpha;
			ctx.strokeStyle = f.tint;
			ctx.fillStyle = f.tint;
			ctx.lineWidth = f.r > 3.5 ? 1.6 : 1;

			// 六向针状晶枝
			for (let i = 0; i < 6; i++) {
				const a = (i * Math.PI) / 3;
				ctx.beginPath();
				ctx.moveTo(0, 0);
				ctx.lineTo(Math.cos(a) * f.r * 2.6, Math.sin(a) * f.r * 2.6);
				ctx.stroke();
			}
			// 中心小六边形核
			ctx.beginPath();
			for (let i = 0; i < 6; i++) {
				const a = (i * Math.PI) / 3;
				const px = Math.cos(a) * f.r * 0.6, py = Math.sin(a) * f.r * 0.6;
				i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
			}
			ctx.closePath();
			ctx.fill();

			// 偶发十字闪光
			const glint = Math.sin(f.tw * 7 + f.phase);
			if (glint > 0.92) {
				ctx.globalAlpha = (glint - 0.92) / 0.08 * 0.8;
				ctx.beginPath();
				ctx.moveTo(-f.r * 2, 0); ctx.lineTo(f.r * 2, 0);
				ctx.moveTo(0, -f.r * 2); ctx.lineTo(0, f.r * 2);
				ctx.lineWidth = 0.8;
				ctx.stroke();
			}
			ctx.restore();
		};

		const tick = (t) => {
			const dt = Math.min((t - lastT) / 1000, 0.05);
			lastT = t;
			ctx.clearRect(0, 0, W, H);

			// 全局缓风 + 鼠标速度衰减
			mouse.vx *= 0.94;
			mouse.vy *= 0.94;
			const wind = Math.sin(t / 6000) * 6;

			for (const f of flakes) {
				f.y += f.spd * dt;
				f.x += (wind + Math.sin(t / 1000 * f.swayFreq + f.phase) * f.swayAmp * 0.4) * dt;

				// 鼠标扰动：晶体在鼠标附近时被明显推开
				const mx = f.x + f.dx - mouse.x, my = f.y + f.dy - mouse.y;
				const d2 = mx * mx + my * my;
				if (d2 < 220 * 220) {
					const d = Math.sqrt(d2) || 1;
					const push = (1 - d / 220) * 160;
					f.dx += (mx / d) * push * dt + mouse.vx * (1 - d / 220) * 0.3;
					f.dy += (my / d) * push * dt * 0.6 + mouse.vy * (1 - d / 220) * 0.3;
				}
				f.dx *= 0.93;
				f.dy *= 0.93;

				f.rot += f.rotSpd * dt;
				f.tw += dt;

				if (f.y > H + 12) { Object.assign(f, makeFlake(true)); continue; }
				if (f.x < -20) f.x = W + 15;
				if (f.x > W + 20) f.x = -15;

				// 闪烁透明度（整体提亮）
				const alpha = 0.5 + 0.45 * (0.5 + 0.5 * Math.sin(f.tw * 2.4 + f.phase));
				drawFlake(f, alpha);
			}
			rafId = requestAnimationFrame(tick);
		};

		const start = () => {
			if (rafId === null) {
				lastT = performance.now();
				rafId = requestAnimationFrame(tick);
			}
		};
		const stop = () => {
			if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
		};

		window.addEventListener('resize', resize, { passive: true });
		window.addEventListener('mousemove', (e) => {
			if (lastMX !== null) {
				mouse.vx = Math.max(-50, Math.min(50, e.clientX - lastMX));
				mouse.vy = Math.max(-50, Math.min(50, e.clientY - lastMY));
			}
			lastMX = mouse.x = e.clientX;
			lastMY = mouse.y = e.clientY;
		}, { passive: true });

		document.addEventListener('visibilitychange', () => {
			document.hidden ? stop() : start();
		});

		resize();
		start();
	})();
</script>
