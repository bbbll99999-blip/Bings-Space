---
// 全页冰晶飘雪（B1）：单个 canvas 层，低密度六角冰晶缓慢下落
// 位置：z-index -1 —— 在背景渐变/光斑之上、内容与玻璃卡之下（透过磨砂玻璃卡看到朦胧晶体）
// 性能：rAF 驱动、密度按视口面积封顶、标签页隐藏即暂停
// 可访问性：prefers-reduced-motion 时不创建
---

<canvas class="ice-field" id="iceField" aria-hidden="true"></canvas>

<style>
	.ice-field {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		pointer-events: none;
	}
</style>

<script is:inline>
	(() => {
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		const canvas = document.getElementById('iceField');
		if (!canvas) return;
		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		let W = 0, H = 0, dpr = 1;
		let flakes = [];
		let rafId = null;
		let lastT = 0;

		// 鼠标扰动：记录位置与速度
		const mouse = { x: -9999, y: -9999, vx: 0, vy: 0 };
		let lastMX = null, lastMY = null;

		// 冰青色系（不碰紫色）
		const TINTS = [
			'rgba(255,255,255,0.9)',
			'rgba(186,230,253,0.85)',
			'rgba(147,197,253,0.75)',
			'rgba(224,242,254,0.9)'
		];

		const rand = (a, b) => a + Math.random() * (b - a);

		const makeFlake = (fromTop) => {
			// 约 1/7 概率生成一颗醒目的大冰晶
			const big = Math.random() < 0.14;
			// 样式混排：树枝雪花 45% / 雪点 45% / 空心六边形 10%
			const roll = Math.random();
			const style = roll < 0.45 ? 'dendrite' : roll < 0.90 ? 'dot' : 'hex';
			return {
				x: rand(0, W),
				y: fromTop ? rand(-60, 0) : rand(0, H),
				r: big ? rand(4.2, 6.4) : rand(1.8, 3.8), // 晶体半径
				spd: big ? rand(22, 46) : rand(14, 38),   // 下落速度 px/s
				swayAmp: rand(8, 26),                     // 横向摇曳幅度
				swayFreq: rand(0.2, 0.6),                 // 摇曳频率
				phase: rand(0, Math.PI * 2),
				rot: rand(0, Math.PI * 2),
				rotSpd: rand(-0.8, 0.8),                  // 自转 rad/s
				tw: rand(0.5, 1),                         // 闪烁相位
				tint: TINTS[(Math.random() * TINTS.length) | 0],
				style,                                    // 样式
				// 碰撞半径：按样式的视觉覆盖范围估算
				cr: style === 'dot' ? 0 : (big ? rand(4.2, 6.4) * 1.9 : rand(1.8, 3.8) * 1.9),
				dx: 0, dy: 0                              // 扰动位移（衰减）
			};
		};

		const resize = () => {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			W = window.innerWidth;
			H = window.innerHeight;
			canvas.width = W * dpr;
			canvas.height = H * dpr;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			const target = Math.min(130, Math.round((W * H) / 11000));
			while (flakes.length < target) flakes.push(makeFlake(false));
			if (flakes.length > target) flakes.length = target;
		};

		// 按样式画雪花：dendrite 树枝结晶 / dot 雪点 / hex 空心六边形 / star 四芒星光
		const drawFlake = (f, alpha) => {
			const L = f.r * 2.4; // 枝长
			ctx.save();
			ctx.translate(f.x + f.dx, f.y + f.dy);
			if (f.style !== 'dot') ctx.rotate(f.rot);
			ctx.globalAlpha = alpha;
			ctx.strokeStyle = f.tint;
			ctx.fillStyle = f.tint;
			ctx.lineCap = 'round';

			// —— 雪点：柔和圆点（实心核 + 淡晕圈），最小最朴素
			if (f.style === 'dot') {
				ctx.beginPath();
				ctx.arc(0, 0, f.r * 0.8, 0, Math.PI * 2);
				ctx.fill();
				ctx.globalAlpha = alpha * 0.35;
				ctx.beginPath();
				ctx.arc(0, 0, f.r * 1.4, 0, Math.PI * 2);
				ctx.fill();
				ctx.restore();
				return;
			}

			ctx.lineWidth = f.r > 3.5 ? 1.3 : 0.9;

			// —— 空心六边形：远处虚焦冰晶感（弱化版：小、淡、无内部点缀）
			if (f.style === 'hex') {
				ctx.globalAlpha = alpha * 0.65;
				ctx.beginPath();
				for (let i = 0; i < 6; i++) {
					const a = (i * Math.PI) / 3;
					const px = Math.cos(a) * f.r * 1.2, py = Math.sin(a) * f.r * 1.2;
					i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
				}
				ctx.closePath();
				ctx.stroke();
				ctx.restore();
				return;
			}

			// —— 树枝状雪花：六根细枝 + 枝上分叉
			const twig = Math.min(L * 0.32, 5); // 分叉长度（小晶体缩短）
			for (let i = 0; i < 6; i++) {
				const a = (i * Math.PI) / 3;
				const ca = Math.cos(a), sa = Math.sin(a);
				ctx.beginPath();
				ctx.moveTo(0, 0);
				ctx.lineTo(ca * L, sa * L);
				ctx.stroke();
				if (twig > 1.6) {
					for (const t of [0.55, 0.8]) {
						const bx = ca * L * t, by = sa * L * t;
						for (const s of [-1, 1]) {
							const b = a + s * Math.PI / 3;
							ctx.beginPath();
							ctx.moveTo(bx, by);
							ctx.lineTo(bx + Math.cos(b) * twig, by + Math.sin(b) * twig);
							ctx.stroke();
						}
					}
				}
			}
			// 中心一个小点收口
			ctx.beginPath();
			ctx.arc(0, 0, Math.min(f.r * 0.35, 1.4), 0, Math.PI * 2);
			ctx.fill();

			// 偶发十字闪光
			const glint = Math.sin(f.tw * 7 + f.phase);
			if (glint > 0.92) {
				ctx.globalAlpha = (glint - 0.92) / 0.08 * 0.8;
				ctx.strokeStyle = f.tint;
				ctx.lineWidth = 0.8;
				ctx.beginPath();
				ctx.moveTo(-L, 0); ctx.lineTo(L, 0);
				ctx.moveTo(0, -L); ctx.lineTo(0, L);
				ctx.stroke();
			}
			ctx.restore();
		};

		const tick = (t) => {
			const dt = Math.min((t - lastT) / 1000, 0.05);
			lastT = t;
			ctx.clearRect(0, 0, W, H);

			// 全局缓风 + 鼠标速度衰减
			mouse.vx *= 0.94;
			mouse.vy *= 0.94;
			const wind = Math.sin(t / 6000) * 6;

			for (const f of flakes) {
				f.y += f.spd * dt;
				f.x += (wind + Math.sin(t / 1000 * f.swayFreq + f.phase) * f.swayAmp * 0.4) * dt;

				// 鼠标扰动：晶体在鼠标附近时被明显推开
				const mx = f.x + f.dx - mouse.x, my = f.y + f.dy - mouse.y;
				const d2 = mx * mx + my * my;
				if (d2 < 220 * 220) {
					const d = Math.sqrt(d2) || 1;
					const push = (1 - d / 220) * 160;
					f.dx += (mx / d) * push * dt + mouse.vx * (1 - d / 220) * 0.3;
					f.dy += (my / d) * push * dt * 0.6 + mouse.vy * (1 - d / 220) * 0.3;
				}
				f.dx *= 0.93;
				f.dy *= 0.93;

				f.rot += f.rotSpd * dt;
				f.tw += dt;

				if (f.y > H + 12) { Object.assign(f, makeFlake(true)); continue; }
				if (f.x < -20) f.x = W + 15;
				if (f.x > W + 20) f.x = -15;

				// 闪烁透明度（整体比默认调低 10%）
				const alpha = Math.max(0.1, 0.5 + 0.45 * (0.5 + 0.5 * Math.sin(f.tw * 2.4 + f.phase)) - 0.1);
				drawFlake(f, alpha);
			}

			// 碰撞分离：雪花两两软性推开，避免重叠（雪点 cr=0 不参与，自然小雪可叠）
			for (let i = 0; i < flakes.length; i++) {
				const a = flakes[i];
				if (!a.cr) continue;
				for (let j = i + 1; j < flakes.length; j++) {
					const b = flakes[j];
					if (!b.cr) continue;
					const dx = (b.x + b.dx) - (a.x + a.dx);
					const dy = (b.y + b.dy) - (a.y + a.dy);
					const min = a.cr + b.cr;
					const d2 = dx * dx + dy * dy;
					if (d2 > 0.001 && d2 < min * min) {
						const d = Math.sqrt(d2);
						const push = (min - d) * 0.4; // 软性分离，防抖动
						const nx = dx / d, ny = dy / d;
						a.x -= nx * push; a.y -= ny * push;
						b.x += nx * push; b.y += ny * push;
					}
				}
			}
			rafId = requestAnimationFrame(tick);
		};

		const start = () => {
			if (rafId === null) {
				lastT = performance.now();
				rafId = requestAnimationFrame(tick);
			}
		};
		const stop = () => {
			if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
		};

		window.addEventListener('resize', resize, { passive: true });
		window.addEventListener('mousemove', (e) => {
			if (lastMX !== null) {
				mouse.vx = Math.max(-50, Math.min(50, e.clientX - lastMX));
				mouse.vy = Math.max(-50, Math.min(50, e.clientY - lastMY));
			}
			lastMX = mouse.x = e.clientX;
			lastMY = mouse.y = e.clientY;
		}, { passive: true });

		document.addEventListener('visibilitychange', () => {
			document.hidden ? stop() : start();
		});

		resize();
		start();
	})();
</script>
