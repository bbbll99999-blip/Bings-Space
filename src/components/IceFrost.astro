---
// B3 霜花角落 v2：角落聚一组完整的六角雪花结晶 + 冰点（弃用抽象枝条方案）
// 前景层 z-index 85（内容上、导航下），pointer-events none，<900px 隐藏
// 注意：Astro frontmatter 不能定义返回 JSX 的函数，只能数据驱动 + 模板内 map
const branch = (len: number, tw: number) =>
	`M0 0 L${len} 0 ` +
	`M${len * 0.5} 0 L${len * 0.5 + tw} ${-tw} M${len * 0.5} 0 L${len * 0.5 + tw} ${tw} ` +
	`M${len * 0.78} 0 L${len * 0.78 + tw * 0.7} ${-tw * 0.7} M${len * 0.78} 0 L${len * 0.78 + tw * 0.7} ${tw * 0.7}`;

const angles = [0, 60, 120, 180, 240, 300];

// 右上角雪花簇（x/y 为 300x300 视口内坐标，R=雪花半径，o=透明度，rot=整体旋转）
const flakesTR = [
	{ x: 150, y: 60, R: 46, o: 0.75, rot: 15 },
	{ x: 62, y: 130, R: 30, o: 0.6, rot: 40 },
	{ x: 185, y: 155, R: 22, o: 0.5, rot: -20 },
	{ x: 110, y: 210, R: 16, o: 0.4, rot: 70 },
];
const dotsTR = [
	{ x: 230, y: 100, r: 3, o: 0.4 }, { x: 95, y: 55, r: 2.4, o: 0.4 }, { x: 205, y: 210, r: 2, o: 0.35 },
];
// 左下角 = 右上角点对称（300 - x/y）
const flakesBL = flakesTR.map((f) => ({ ...f, x: 300 - f.x, y: 300 - f.y }));
const dotsBL = dotsTR.map((d) => ({ ...d, x: 300 - d.x, y: 300 - d.y }));
---

<svg class="frost frost-tr" viewBox="0 0 300 300" aria-hidden="true">
	{flakesTR.map((f) => (
		<g transform={`translate(${f.x} ${f.y}) rotate(${f.rot})`} opacity={f.o}>
			{angles.map((a) => (
				<path
					d={branch(f.R, f.R * 0.22)}
					transform={`rotate(${a})`}
					fill="none"
					stroke="#38bdf8"
					stroke-width={f.R * 0.09}
					stroke-linecap="round"
				/>
			))}
			<circle r={f.R * 0.14} fill="#38bdf8" />
		</g>
	))}
	{dotsTR.map((d) => (
		<circle cx={d.x} cy={d.y} r={d.r} fill="#38bdf8" opacity={d.o} />
	))}
</svg>

<svg class="frost frost-bl" viewBox="0 0 300 300" aria-hidden="true">
	{flakesBL.map((f) => (
		<g transform={`translate(${f.x} ${f.y}) rotate(${f.rot})`} opacity={f.o}>
			{angles.map((a) => (
				<path
					d={branch(f.R, f.R * 0.22)}
					transform={`rotate(${a})`}
					fill="none"
					stroke="#38bdf8"
					stroke-width={f.R * 0.09}
					stroke-linecap="round"
				/>
			))}
			<circle r={f.R * 0.14} fill="#38bdf8" />
		</g>
	))}
	{dotsBL.map((d) => (
		<circle cx={d.x} cy={d.y} r={d.r} fill="#38bdf8" opacity={d.o} />
	))}
</svg>

<style>
	.frost {
		position: fixed;
		width: 300px;
		height: 300px;
		z-index: 85; /* 前景层：结在屏幕玻璃上的霜（内容上、导航 z-100 下） */
		pointer-events: none;
		opacity: 0.4;
	}
	.frost-tr {
		top: 0;
		right: 0;
	}
	.frost-bl {
		bottom: 0;
		left: 0;
	}
	@media (max-width: 900px) {
		.frost { display: none; }
	}
</style>
