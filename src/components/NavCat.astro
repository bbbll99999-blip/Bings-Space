---
// 导航条装饰：AI 生成的 Q 版蓝毛女孩（5 帧视线），趴在导航条上
// 交互：根据鼠标方位切换视线帧（中/左上/右上/左下/右下）+ 整体轻微视差移动
// pointer-events:none 不挡点击；<900px 隐藏；prefers-reduced-motion 静止
---

<div class="nav-cat" id="navCat" aria-hidden="true">
	<img class="cat-frame" src="/images/navcat/center.png" data-dir="c" alt="" decoding="async" draggable="false" />
	<img class="cat-frame" src="/images/navcat/lu.png" data-dir="lu" alt="" loading="lazy" decoding="async" draggable="false" />
	<img class="cat-frame" src="/images/navcat/ru.png" data-dir="ru" alt="" loading="lazy" decoding="async" draggable="false" />
	<img class="cat-frame" src="/images/navcat/ld.png" data-dir="ld" alt="" loading="lazy" decoding="async" draggable="false" />
	<img class="cat-frame" src="/images/navcat/rd.png" data-dir="rd" alt="" loading="lazy" decoding="async" draggable="false" />
</div>

<style>
	.nav-cat {
		position: absolute;
		top: -84px;
		right: 4%;
		width: 96px;
		height: 84px;
		pointer-events: none;
		user-select: none;
	}
	/* 5 帧叠放，视线帧切换 = 透明度切换（全部预加载，无闪烁） */
	.cat-frame {
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: auto;
		opacity: 0;
		transition: opacity 0.18s ease;
	}
	.cat-frame[data-dir='c'] { opacity: 1; }
	.nav-cat.moving .cat-frame { will-change: opacity, transform; }

	@media (max-width: 900px) {
		.nav-cat { display: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.nav-cat { transform: none !important; }
	}
</style>

<script is:inline>
	(() => {
		const cat = document.getElementById('navCat');
		if (!cat) return;
		const frames = cat.querySelectorAll('.cat-frame');
		const byDir = {};
		frames.forEach((f) => (byDir[f.dataset.dir] = f));

		let curDir = 'c';
		let tx = 0, ty = 0, cx = 0, cy = 0;
		let rafId = null;

		const onMove = (e) => {
			const rect = cat.getBoundingClientRect();
			const dx = (e.clientX - (rect.left + rect.width / 2)) / window.innerWidth;
			const dy = (e.clientY - (rect.top + rect.height / 2)) / window.innerHeight;
			const nx = Math.max(-1, Math.min(1, dx * 2.5));
			const ny = Math.max(-1, Math.min(1, dy * 2.5));

			// 视线方向：死区内看前方，超出后按象限选帧
			let dir = 'c';
			if (Math.abs(nx) > 0.18 || Math.abs(ny) > 0.18) {
				dir = (ny < 0 ? 'u' : 'd') === 'u'
					? (nx < 0 ? 'lu' : 'ru')
					: (nx < 0 ? 'ld' : 'rd');
				// 水平接近中线时优先表达上下，垂直接近中线时优先表达左右
				if (Math.abs(nx) < 0.12) dir = ny < 0 ? 'lu' : 'ld';
				if (Math.abs(ny) < 0.12) dir = nx < 0 ? 'lu' : 'ru';
			}
			if (dir !== curDir) {
				byDir[curDir].style.opacity = '0';
				byDir[dir].style.opacity = '1';
				curDir = dir;
			}

			// 整体轻微视差（幅度小，手部扒边不被破坏）
			tx = nx * 3; ty = ny * 2;
			if (rafId === null) tick();
		};

		const tick = () => {
			cx += (tx - cx) * 0.12;
			cy += (ty - cy) * 0.12;
			cat.style.transform = `translate(${cx.toFixed(2)}px, ${cy.toFixed(2)}px)`;
			if (Math.abs(tx - cx) > 0.05 || Math.abs(ty - cy) > 0.05) {
				rafId = requestAnimationFrame(tick);
			} else {
				rafId = null;
			}
		};

		document.addEventListener('mousemove', onMove, { passive: true });
	})();
</script>
