---
// 导航条装饰：Q 版蓝毛女孩（慌张流汗表情），趴在导航条上
// 架构：一张静态身体图 + 一层"只有眼睛"的图（9 个方向帧）
// 视线跟随 = 眼层帧切换（交叉淡化）+ 眼层连续微移，身体不动
// pointer-events:none 不挡点击；<900px 隐藏；prefers-reduced-motion 静止
const eyeDirs = ['c', 'lu', 'u', 'ru', 'l', 'r', 'ld', 'd', 'rd'];
---

<div class="nav-cat" id="navCat" aria-hidden="true">
	<img class="cat-body" src="/images/navcat/body.png" alt="" decoding="async" draggable="false" />
	<div class="cat-eyes" id="catEyes">
		{eyeDirs.map((d) => (
			<img class="eye-frame" src={`/images/navcat/eyes_${d}.png`} data-dir={d} alt="" decoding="async" draggable="false" />
		))}
	</div>
</div>

<style>
	.nav-cat {
		position: absolute;
		top: -86px;
		left: 4%;
		width: 96px;
		height: 86px;
		pointer-events: none;
		user-select: none;
	}
	.cat-body {
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: auto;
	}
	/* 眼层：与身体对齐（百分比定位自素材处理脚本输出） */
	.cat-eyes {
		position: absolute;
		left: 21.71%;
		top: 60.875%;
		width: 56.24%;
		height: 25%;
	}
	/* 9 帧眼图叠放，切换 = 透明度交叉淡化（全部立即加载，无闪烁） */
	.eye-frame {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		transition: opacity 0.12s linear;
		will-change: opacity;
	}
	.eye-frame[data-dir='c'] { opacity: 1; }

	@media (max-width: 900px) {
		.nav-cat { display: none; }
	}
</style>

<script is:inline>
	(() => {
		const cat = document.getElementById('navCat');
		const eyes = document.getElementById('catEyes');
		if (!cat || !eyes) return;
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		const frames = {};
		eyes.querySelectorAll('.eye-frame').forEach((f) => (frames[f.dataset.dir] = f));

		let tx = 0, ty = 0;   // 目标视线向量（-1..1）
		let vx = 0, vy = 0;   // 缓动后的当前视线向量
		let curDir = 'c';
		let rafId = null;

		// 角度 → 8 方向帧名
		const dirOf = (x, y) => {
			const a = Math.atan2(-y, x) * 180 / Math.PI; // 屏幕坐标 y 向下，取反成数学角
			const names = ['r', 'ru', 'u', 'lu', 'l', 'ld', 'd', 'rd'];
			return names[Math.round(((a + 360) % 360) / 45) % 8];
		};

		const onMove = (e) => {
			const rect = cat.getBoundingClientRect();
			const nx = (e.clientX - (rect.left + rect.width / 2)) / window.innerWidth;
			const ny = (e.clientY - (rect.top + rect.height / 2)) / window.innerHeight;
			tx = Math.max(-1, Math.min(1, nx * 2.2));
			ty = Math.max(-1, Math.min(1, ny * 2.2));
			if (rafId === null) rafId = requestAnimationFrame(tick);
		};

		const tick = () => {
			vx += (tx - vx) * 0.14;
			vy += (ty - vy) * 0.14;

			// 眼层连续微移（亚帧级平滑）
			eyes.style.transform = `translate(${(vx * 2).toFixed(2)}px, ${(vy * 1.6).toFixed(2)}px)`;

			// 帧选择：死区内看前方，按角度选 8 方向
			let dir = 'c';
			if (Math.hypot(vx, vy) > 0.15) dir = dirOf(vx, vy);
			if (dir !== curDir) {
				frames[curDir].style.opacity = '0';
				frames[dir].style.opacity = '1';
				curDir = dir;
			}

			if (Math.abs(tx - vx) > 0.01 || Math.abs(ty - vy) > 0.01) {
				rafId = requestAnimationFrame(tick);
			} else {
				rafId = null;
			}
		};

		document.addEventListener('mousemove', onMove, { passive: true });
	})();
</script>
