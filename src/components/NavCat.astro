---
// 导航条装饰：Q版蓝毛女孩趴在导航条上，视线/头部跟随鼠标
// 素材：AI 抠图后的透明 PNG（public/images/navcat.png，20KB）
// 交互：整体轻移+微倾斜模拟"转头看你"；rAF 节流；pointer-events:none 不挡点击
---

<div class="nav-cat" id="navCat" aria-hidden="true">
	<img id="navCatImg" src="/images/navcat.png" alt="" decoding="async" draggable="false" />
</div>

<style>
	.nav-cat {
		position: absolute;
		top: -78px;
		right: 6%;
		width: 88px;
		height: 78px;
		overflow: hidden; /* 底部被导航条上边缘裁掉，形成"趴着"效果 */
		pointer-events: none;
		user-select: none;
	}
	.nav-cat img {
		position: absolute;
		top: 0;
		left: 50%;
		width: 92px; /* 高约 89px，裁切线落在下巴下方（88%） */
		margin-left: -46px;
		height: auto;
		transform-origin: 50% 100%; /* 以"趴着的手"为原点转动 */
		will-change: transform;
	}

	/* 窄屏隐藏：导航空间有限，且触屏没有"鼠标视野" */
	@media (max-width: 900px) {
		.nav-cat { display: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.nav-cat img { transform: none !important; }
	}
</style>

<script is:inline>
	(() => {
		const cat = document.getElementById('navCat');
		const img = document.getElementById('navCatImg');
		if (!cat || !img) return;

		let targetX = 0, targetY = 0;   // 目标偏移（-1 ~ 1 归一化）
		let curX = 0, curY = 0;         // 当前偏移（缓动）
		let rafId = null;

		const onMove = (e) => {
			const rect = cat.getBoundingClientRect();
			// 以猫为原点的方向向量，按视口对角线归一化并限幅
			const dx = (e.clientX - (rect.left + rect.width / 2)) / window.innerWidth;
			const dy = (e.clientY - (rect.top + rect.height / 2)) / window.innerHeight;
			targetX = Math.max(-1, Math.min(1, dx * 2));
			targetY = Math.max(-1, Math.min(1, dy * 2));
			if (rafId === null) tick();
		};

		const tick = () => {
			// 缓动逼近目标，动作更柔和
			curX += (targetX - curX) * 0.12;
			curY += (targetY - curY) * 0.12;
			img.style.transform =
				`translate(${(curX * 9).toFixed(2)}px, ${(curY * 5).toFixed(2)}px) rotate(${(curX * 4).toFixed(2)}deg)`;
			if (Math.abs(targetX - curX) > 0.002 || Math.abs(targetY - curY) > 0.002) {
				rafId = requestAnimationFrame(tick);
			} else {
				rafId = null;
			}
		};

		document.addEventListener('mousemove', onMove, { passive: true });
	})();
</script>
