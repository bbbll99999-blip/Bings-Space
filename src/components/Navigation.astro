---
import NavCat from './NavCat.astro';

const currentPath = Astro.url.pathname;
---

<nav class="navigation glass-card">
	<NavCat />
	<a href="/" class="logo">Bing's Space</a>
	<div class="nav-right">
		<div class="nav-links">
			<a href="/" class={currentPath === '/' ? 'active' : ''}>首页</a>
			<a href="/journal" class={currentPath === '/journal' ? 'active' : ''}>日志</a>
			<a href="/songs" class={currentPath === '/songs' ? 'active' : ''}>一些翻唱</a>
			<a href="/graphics" class={currentPath === '/graphics' ? 'active' : ''}>平面作品</a>
			<a href="/about" class={currentPath === '/about' ? 'active' : ''}>关于我</a>
		</div>
		<button class="theme-toggle" id="themeToggle" aria-label="切换深色模式" title="切换深色模式">
			<svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
			</svg>
			<svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="12" cy="12" r="4" />
				<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
			</svg>
		</button>
	</div>
</nav>

<script is:inline>
	// View Transitions 下内联脚本若内容相同会被去重、不再重跑，
	// 导致换页后新按钮没挂事件 → 把初始化包成函数，在 astro:after-swap 后重挂
	function initThemeToggle() {
		const btn = document.getElementById('themeToggle');
		if (!btn || btn.dataset.bound) return;
		btn.dataset.bound = '1';
		btn.addEventListener('click', () => {
			const html = document.documentElement;
			const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
			html.dataset.theme = next;
			try { localStorage.setItem('theme', next); } catch (e) {}
		});
	}
	initThemeToggle();
	if (!window.__themeToggleHook) {
		window.__themeToggleHook = true;
		document.addEventListener('astro:after-swap', initThemeToggle);
	}
</script>

<style>
	.navigation {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1rem 2rem;
		margin-top: 6rem; /* 给趴在导航条上的小蓝留出完整探头空间（形象高 86px，6rem=96px 保证页面顶部与吸顶时都不裁切） */
		margin-bottom: 2rem;
		position: sticky;
		top: 6rem;
		z-index: 100;
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.nav-links {
		display: flex;
		gap: 2rem;
	}

	.nav-links a {
		color: var(--text-primary);
		text-decoration: none;
		font-weight: 500;
		font-size: 1rem;
		transition: all 0.2s ease;
		position: relative;
	}

	.nav-links a::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 0;
		height: 2px;
		background: linear-gradient(135deg, var(--grad-start) 0%, var(--grad-end) 100%);
		transition: width 0.3s ease;
	}

	.nav-links a:hover::after,
	.nav-links a.active::after {
		width: 100%;
	}

	/* T2 结霜：悬停时链接文字泛起冰晶微光 */
	.nav-links a:hover {
		color: var(--grad-start);
		text-shadow:
			0 0 8px rgba(191, 219, 254, 0.9),
			0 0 14px rgba(147, 197, 253, 0.5);
	}

	.nav-links a.active {
		color: var(--grad-end);
	}

	/* 日/夜切换按钮 */
	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		flex-shrink: 0;
		background: var(--soft-bg);
		border: 1px solid var(--soft-border);
		border-radius: 12px;
		color: var(--text-primary);
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.theme-toggle:hover {
		background: var(--grad-start);
		border-color: var(--grad-start);
		color: #fff;
		transform: scale(1.06);
	}

	/* 亮色显示月亮（点击切到暗色），暗色显示太阳 */
	.theme-toggle .icon-sun { display: none; }
	.theme-toggle .icon-moon { display: block; }
	:global(html[data-theme='dark']) .theme-toggle .icon-sun { display: block; }
	:global(html[data-theme='dark']) .theme-toggle .icon-moon { display: none; }

	.logo {
		font-size: 1.5rem;
		font-weight: 800;
		background: linear-gradient(135deg, var(--grad-start) 0%, var(--grad-end) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		text-decoration: none;
	}

	@media (max-width: 768px) {
		.navigation {
			flex-direction: column;
			gap: 1rem;
		}

		.nav-right {
			flex-direction: column;
			gap: 1rem;
		}

		.nav-links {
			gap: 1rem;
		}
	}
</style>
