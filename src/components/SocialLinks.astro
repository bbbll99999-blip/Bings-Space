<style>
	.social-links {
		padding: 2rem;
		width: 100%;
		/* 移除最大宽度限制，让它和个人信息一样宽 */
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		background: rgba(255, 255, 255, 0.7);
		border-radius: 24px;
		box-sizing: border-box;
		height: 100%; /* 拉伸填满容器 */
	}

	h2 {
		margin: 0 0 1.5rem;
		font-size: 1.5rem;
		font-weight: 700;
		color: #1e293b;
		text-align: center;
	}

	.links {
		display: grid;
		/* 使用 1fr 让按钮填满空间 */
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
		width: 100%;
		flex: 1; /* 让链接区域占据剩余空间 */
	}

	.social-link {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		padding: 1.5rem 1rem;
		width: 100%;
		aspect-ratio: 1 / 1; /* 保持正方形 */
		background: white;
		border-radius: 16px;
		text-decoration: none;
		color: #475569;
		transition: all 0.3s ease;
		border: 1px solid rgba(0,0,0,0.05);
		box-sizing: border-box;
	}

	.social-link:hover {
		background: rgba(102, 126, 234, 0.05);
		transform: translateY(-4px);
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
	}

	.social-link svg {
		width: 32px;
		height: 32px;
		color: #3b82f6;
	}

	.social-link span {
		font-size: 1rem;
		font-weight: 600;
	}
</style>
