<!-- src/components/TimeButton.astro -->
<div class="time-button" id="timeButton">
  <span id="liveTime">--:--:--</span>
</div>

<script>
  // 模块脚本全站只执行一次；View Transitions 换页后 DOM 已换新，
  // 用 window 上的旧 interval 句柄做清理，防止多个 interval 并跑
  function updateTime() {
    const now = new Date();
    const timeStr = now.toLocaleTimeString('zh-CN', { hour12: false });
    const el = document.getElementById('liveTime');
    if (el) el.textContent = timeStr;
  }
  if (window.__timeTimer) clearInterval(window.__timeTimer);
  updateTime();
  window.__timeTimer = setInterval(updateTime, 1000);
</script>

<style>
  .time-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    /* 核心修改：缩小字号和宽度 */
    font-size: 1.4rem; 
    font-weight: 700;
    font-family: 'Courier New', monospace;
    letter-spacing: 1px;
    background: var(--soft-bg);
    backdrop-filter: blur(4px);
    border-radius: 12px;
    border: 1px solid var(--soft-border);
    color: var(--text-primary);
    width: fit-content;
    min-width: 140px;
    text-align: center;
    transition: all 0.2s ease;
  }
  .time-button:hover {
    background: var(--item-bg-hover);
    transform: scale(1.02);
  }
</style>