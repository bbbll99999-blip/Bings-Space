---
interface Props {
	title?: string;
	description?: string;
}

const { title = "Bing's Space - 冰冰蓝的小角落", description = '冰冰蓝的个人主页，记录音乐作品、平面设计、绘画创作与日志。' } = Astro.props;
import IceField from '../components/IceField.astro';
import IceBurst from '../components/IceBurst.astro';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<!-- 主题预置：在首帧渲染前确定 light/dark，避免闪白/闪黑 -->
		<script is:inline>
			(() => {
				try {
					// 优先级：URL 参数（调试用）> localStorage > 系统偏好
					const urlTheme = new URLSearchParams(location.search).get('theme');
					const saved = localStorage.getItem('theme');
					const theme = urlTheme || saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
					document.documentElement.dataset.theme = theme;
				} catch (e) {
					document.documentElement.dataset.theme = 'light';
				}
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<div class="background-gradient"></div>
		<div class="background-shapes">
			<div class="shape shape-1"></div>
			<div class="shape shape-2"></div>
			<div class="shape shape-3"></div>
		</div>
		<IceField />
		<IceBurst />
		<slot />
	</body>
</html>

<style is:global>
	/* ── 主题变量（暗色 = 冰夜蓝黑，禁紫） ─────────────────── */
	:root {
		color-scheme: light;
		--bg-body: #f5f7fa;
		--text-primary: #1e293b;   /* 标题 */
		--text-body: #475569;      /* 正文 */
		--text-secondary: #64748b; /* 次要 */
		--text-muted: #94a3b8;     /* 弱化 */
		--text-faint: #cbd5e1;     /* 序号等点缀 */
		--grad-start: #3b82f6;
		--grad-end: #2563eb;

		--card-bg: rgba(255, 255, 255, 0.7);
		--card-border: rgba(255, 255, 255, 0.3);
		--card-inset: rgba(255, 255, 255, 0.8);
		--card-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);

		--tile-bg: #ffffff;                    /* 卡片内的白底小块（社交按钮/技能卡/作品卡） */
		--tile-border: rgba(0, 0, 0, 0.05);
		--soft-bg: rgba(255, 255, 255, 0.4);   /* 日历格 / 时间按钮 */
		--soft-border: rgba(255, 255, 255, 0.3);
		--item-bg: rgba(255, 255, 255, 0.5);   /* 日志列表项等半透明块 */
		--item-bg-hover: rgba(255, 255, 255, 0.9);
		--workcard-bg: rgba(255, 255, 255, 0.8);
		--img-ph: #f0f9ff;                     /* 图片占位背景 */

		--divider: #f1f5f9;        /* 分割线 / 表格行线 */
		--divider-strong: #f8fafc; /* 表头底线 */
		--row-hover: #fafafa;      /* 表格行悬停 */
		--line: #e2e8f0;           /* 描边线 */
		--hairline: rgba(0, 0, 0, 0.1);
	}

	html[data-theme='dark'] {
		color-scheme: dark;
		--bg-body: #0d1526;
		--text-primary: #e2e8f0;
		--text-body: #a9b7cc;
		--text-secondary: #8ba0b9;
		--text-muted: #7189a6;
		--text-faint: #4a5e7d;
		--grad-start: #60a5fa;
		--grad-end: #3b82f6;

		--card-bg: rgba(17, 27, 45, 0.72);
		--card-border: rgba(148, 163, 184, 0.18);
		--card-inset: rgba(255, 255, 255, 0.06);
		--card-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);

		--tile-bg: #18243c;
		--tile-border: rgba(148, 163, 184, 0.15);
		--soft-bg: rgba(148, 163, 184, 0.1);
		--soft-border: rgba(148, 163, 184, 0.2);
		--item-bg: rgba(20, 31, 52, 0.6);
		--item-bg-hover: rgba(30, 43, 68, 0.85);
		--workcard-bg: rgba(23, 34, 56, 0.8);
		--img-ph: #16233a;

		--divider: #22304a;
		--divider-strong: #1d2b44;
		--row-hover: rgba(255, 255, 255, 0.03);
		--line: #2a3a58;
		--hairline: rgba(148, 163, 184, 0.25);
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100vh;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		overflow-x: clip; /* clip 不创建滚动容器，不会像 hidden 那样破坏导航条的 position: sticky */
	}

	body {
		position: relative;
		background: var(--bg-body);
		color: var(--text-body);
		transition: background-color 0.25s ease, color 0.25s ease;
	}

	.background-gradient {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		/* B2 冰面渐变：左上掺入冰青色，向右下过渡到原有的蓝绿深色 */
		background: linear-gradient(135deg, #67e8f9 0%, #3db5e4 40%, #004758 100%);
		opacity: 0.06;
		z-index: -2;
	}

	html[data-theme='dark'] .background-gradient {
		opacity: 0.14; /* 暗色下冰青渐变更明显一点，避免死黑 */
	}

	.background-shapes {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		overflow: hidden;
		z-index: -1;
	}

	.shape {
		position: absolute;
		border-radius: 50%;
		filter: blur(80px);
		opacity: 0.3;
		animation: float 20s infinite ease-in-out;
	}

	html[data-theme='dark'] .shape {
		opacity: 0.16; /* 暗色下光斑收敛，不抢内容 */
	}

	.shape-1 {
		width: 400px;
		height: 400px;
		background: linear-gradient(135deg, #67e8f9 0%, #b4d7ff 100%); /* 原 #667eea 紫色系违规，换冰青色 */
		top: -200px;
		right: -200px;
		animation-delay: 0s;
	}

	.shape-2 {
		width: 500px;
		height: 500px;
		background: linear-gradient(135deg, #bfdbfe 0%, #3b82f6 100%);
		bottom: -250px;
		left: -250px;
		animation-delay: -7s;
	}

	.shape-3 {
		width: 300px;
		height: 300px;
		background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		animation-delay: -14s;
	}

	@keyframes float {
		0%, 100% {
			transform: translate(0, 0) scale(1);
		}
		33% {
			transform: translate(50px, -50px) scale(1.1);
		}
		66% {
			transform: translate(-30px, 30px) scale(0.9);
		}
	}

	.glass-card {
		background-color: var(--card-bg);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-radius: 16px;
		border: 1px solid var(--card-border);
		box-shadow:
			var(--card-shadow),
			inset 0 1px 0 var(--card-inset);
		transition: background-color 0.25s ease, border-color 0.25s ease;
	}

	/* ── 暗色模式：给蓝色大字加白色描边，避免深底上看不清 ──
	   paint-order: stroke fill 让描边画在填充后面（外侧），不啃掉渐变字芯；
	   旧浏览器不支持时描边会压在字上，视觉略瘦但可接受 */
	html[data-theme='dark'] :is(.page-header h1, .hero h1, .section-header h2) {
		-webkit-text-stroke: 3px rgba(255, 255, 255, 0.55);
		paint-order: stroke fill;
	}

	html[data-theme='dark'] .category-badge {
		-webkit-text-stroke: 2px rgba(255, 255, 255, 0.55);
		paint-order: stroke fill;
	}

	/* 小号蓝字（关于我副标题）描边细一些 */
	html[data-theme='dark'] .subtitle {
		-webkit-text-stroke: 1.2px rgba(255, 255, 255, 0.5);
		paint-order: stroke fill;
	}
</style>
