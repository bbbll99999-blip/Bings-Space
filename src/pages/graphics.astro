// ── 图片方案说明 ───────────────────────────────────────────────
// 全部预览图已本地化到 public/graphics/<项目slug>/：
//   01.jpg       全尺寸 JPEG（q88，灯箱点击时才加载）
//   01.thumb.jpg 120px 缩略图（列表网格用，首屏总计 <1MB）
// 历史教训：曾用阿里 CDN 的 "_宽x高.jpg" 缩放参数，该服务极不稳定
// （同一地址时而 200 时而 404），已彻底弃用。新增图片时把原图
// 转成 JPEG 放入对应目录即可，保持全名 + .thumb.jpg 成对。

// 列表网格用小缩略图；非 /graphics/ 本地图（如遗留失效图）直接用原地址
const thumbSrc = (src: string) =>
	src.startsWith('/graphics/') ? src.replace(/\.jpg$/, '.thumb.jpg') : src;

