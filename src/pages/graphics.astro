---

<Layout title="平面作品 - Bing's Space" description="这里展示了我制作的电商平面设计与旺铺装修作品。">
	<div class="container">
		<Navigation />

		<div class="page-header">
			<h1>平面作品</h1>
			<p>电商视觉设计 / 旺铺全案装修</p>
		</div>

		<div class="works-grid">
			{graphicWorks.map(group => (
				<div class="time-section">
					<h2 class="time-title">
						<span class="dot"></span>
						{group.time}
					</h2>
					<div class="works-list">
						{group.works.map(work => (
							<div class="work-card glass-card">
								{work.previewImages && work.previewImages.length > 0 && (
									<div class="image-gallery">
										<div class="featured-image">
											<img src={work.previewImages[0]} alt={`${work.name} 预览`} />
										</div>
										<div class="thumbnail-row">
											{work.previewImages.slice(1).map(img => (
												<div class="thumb">
													<img src={img} alt="预览缩略图" />
												</div>
											))}
										</div>
									</div>
								)}
								<div class="work-info">
									<h3>{work.name}</h3>
									<a href={work.url} target="_blank" rel="noopener noreferrer" class="visit-link">
										访问站点 
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
											<polyline points="15 3 21 3 21 9"></polyline>
											<line x1="10" y1="14" x2="21" y2="3"></line>
										</svg>
									</a>
								</div>
							</div>
						))}
					</div>
				</div>
			))}
		</div>

		<div class="footer-note">
			<p>预览图片正在持续更新中...</p>
		</div>
	</div>
</Layout>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	.page-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.page-header h1 {
		font-size: 3.5rem;
		font-weight: 800;
		background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin: 0 0 1rem;
	}

	.page-header p {
		font-size: 1.25rem;
		color: #64748b;
		letter-spacing: 4px;
		font-weight: 500;
		text-transform: uppercase;
	}

	.works-grid {
		display: grid;
		gap: 4rem;
	}

	.time-title {
		display: flex;
		align-items: center;
		gap: 1rem;
		font-size: 1.5rem;
		font-weight: 800;
		color: #1e293b;
		margin-bottom: 2rem;
		border-bottom: 2px solid #e2e8f0;
		padding-bottom: 0.75rem;
	}

	.time-title .dot {
		width: 12px;
		height: 12px;
		background: #3b82f6;
		border-radius: 50%;
		box-shadow: 0 0 10px rgba(59, 130, 246, 0.5);
	}

	.works-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 2rem;
	}

	.work-card {
		overflow: hidden;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		background: rgba(255, 255, 255, 0.8);
		border: 1px solid rgba(255, 255, 255, 0.3);
		display: flex;
		flex-direction: column;
	}

	.work-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 12px 30px rgba(59, 130, 246, 0.15);
		background: white;
	}

	.image-gallery {
		width: 100%;
		background: #f8fafc;
	}

	.featured-image {
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #f1f5f9;
	}

	.featured-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.work-card:hover .featured-image img {
		transform: scale(1.05);
	}

	.thumbnail-row {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2px;
		margin-top: 2px;
	}

	.thumb {
		aspect-ratio: 1 / 1;
		overflow: hidden;
		background: #f1f5f9;
	}

	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.8;
		transition: opacity 0.3s ease;
	}

	.thumb:hover img {
		opacity: 1;
	}

	.work-info {
		padding: 1.5rem;
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.work-card h3 {
		font-size: 1.15rem;
		font-weight: 700;
		color: #1e293b;
		margin: 0 0 1rem;
	}

	.visit-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: #3b82f6;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9rem;
		transition: color 0.2s ease;
	}

	.visit-link:hover {
		color: #2563eb;
	}

	.footer-note {
		margin-top: 6rem;
		text-align: center;
		color: #94a3b8;
		font-style: italic;
		border-top: 1px dashed #e2e8f0;
		padding-top: 2rem;
	}

	@media (max-width: 768px) {
		.page-header h1 { font-size: 2.5rem; }
		.works-list { grid-template-columns: 1fr; }
	}
</style>
