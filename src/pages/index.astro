---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import PersonalInfo from '../components/PersonalInfo.astro';
import Calendar from '../components/Calendar.astro';
import SocialLinks from '../components/SocialLinks.astro';
import LatestArticles from '../components/LatestArticles.astro';
import FeaturedWorks from '../components/FeaturedWorks.astro';
---

<Layout title="首页 - Bing's Space">
	<div class="container">
		<Navigation />

		<div class="header-modules">
			<div class="module-col"><PersonalInfo /></div>
			<div class="module-col"><Calendar /></div>
			<div class="module-col"><SocialLinks /></div>
		</div>

		<!-- 强力分割线：带有一点阴影和厚度，区分上下 -->
		<div class="section-divider"></div>

		<main class="main-content">
			<FeaturedWorks />
			<div class="section-divider inner-divider"></div>
			<LatestArticles />
		</main>
	</div>
</Layout>

<style>
	.container {
		max-width: 1400px;
		margin: 0 auto;
		padding: 2rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0; 
	}

	:global(nav) {
		margin-bottom: 2rem !important;
	}

	.header-modules {
		display: grid;
		/* minmax(0, 1fr) 防止内容撑破列宽导致卡片溢出容器 */
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem; /* 减小间距，给模块更多呼吸空间 */
		align-items: stretch;
		width: 100%;
		margin-bottom: 3rem; /* 模块下方的间距 */
	}

	/* 核心修改：分割线样式 */
	.section-divider {
		width: 100%;
		height: 4px;
		background: #f1f5f9; /* 浅灰色背景 */
		border-radius: 10px;
		margin: 2rem 0 4rem; /* 增加上下留白 */
		box-shadow: inset 0 1px 2px rgba(0,0,0,0.02);
	}

	.module-col {
		width: 100%;
		min-width: 0;
		display: flex;
		justify-content: center;
		align-items: stretch;
	}

	/* 保证三栏内的卡片高度完全对齐，且不超过所属列宽 */
	.module-col > :global(*) {
		width: 100%;
		max-width: 100%;
		height: 100%;
	}

	.main-content {
		width: 100%;
		/* 这里不再需要 border-top，因为上面有了 section-divider */
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	/* 内容区内部分割线（作品精选与日志之间），比顶部主分割线轻一些 */
	.section-divider.inner-divider {
		margin: 4.5rem 0 4.5rem;
	}

	@media (max-width: 1200px) {
		.header-modules { grid-template-columns: 1fr; gap: 3rem; }
	}
</style>  