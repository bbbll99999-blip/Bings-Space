---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';

const allPosts = await getCollection('posts');

const postsByCategory = allPosts.reduce((acc, post) => {
	const category = post.data.category || '未分类';
	if (!acc[category]) {
		acc[category] = [];
	}
	acc[category].push(post);
	return acc;
}, {} as Record<string, typeof allPosts>);

Object.keys(postsByCategory).forEach(category => {
	postsByCategory[category].sort((a, b) =>
		b.data.pubDate.getTime() - a.data.pubDate.getTime()
	);
});

const categories = Object.keys(postsByCategory).sort();
---

<Layout title="日志 - Bing's Space" description="记录生活中的每一个平凡与不平凡">
	<div class="container">
		<Navigation />

		<div class="page-header">
			<h1>日志</h1>
			<p>记录生活中的每一个平凡与不平凡</p>
			<div class="search-wrap">
				<svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="11" cy="11" r="8" />
					<path d="M21 21l-4.35-4.35" />
				</svg>
				<input
					type="search"
					id="journalSearch"
					class="journal-search"
					placeholder="搜索日志标题 / 内容摘要…"
					autocomplete="off"
				/>
			</div>
			<p class="search-hint" id="searchHint"></p>
		</div>

		<div class="categories-grid">
			{categories.map(category => {
				const posts = postsByCategory[category];
				const postCount = posts.length;

				return (
					<div class="category-section">
						<div class="category-header">
							<h2 class="category-badge">{category}</h2>
							<span class="post-count">{postCount} 篇日志</span>
						</div>
						<div class="posts-list">
							{posts.map(post => (
								<article class="post-item">
									<a href={`/posts/${post.slug}`} class="post-link">
										<h3>{post.data.title}</h3>
										<p class="description">{post.data.description}</p>
										<div class="post-meta">
											<span class="date">
												{post.data.pubDate.toLocaleDateString('zh-CN', {
													year: 'numeric',
													month: 'long',
													day: 'numeric'
												})}
											</span>
										</div>
									</a>
								</article>
							))}
						</div>
					</div>
				);
			})}
		</div>
	</div>
</Layout>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	.page-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.page-header h1 {
		font-size: 3rem;
		font-weight: 800;
		margin: 0 0 1rem;
		background: linear-gradient(135deg, var(--grad-start) 0%, var(--grad-end) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.page-header p {
		font-size: 1.2rem;
		color: var(--text-secondary);
		margin: 0;
	}

	.categories-grid {
		display: grid;
		gap: 3rem;
	}

	.category-section {
		padding: 1rem 0;
	}

	.category-header {
		display: flex;
		justify-content: flex-start;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 2px solid var(--divider);
	}

	.category-badge {
		font-size: 1.4rem;
		font-weight: 800;
		background: linear-gradient(135deg, var(--grad-start) 0%, var(--grad-end) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		display: inline-block;
		margin: 0;
		border-bottom: 2px solid #3b82f6; /* 加一条底线，显得更稳重 */
		padding-bottom: 0.2rem;
	}

	.post-count {
		color: var(--text-muted);
		font-size: 1rem;
		font-weight: 600;
		background: transparent;
		padding: 0;
		border-radius: 0;
		box-shadow: none;
	}

	.posts-list {
		display: grid;
		gap: 1.5rem;
	}

	.post-item {
		background: var(--item-bg);
		border-radius: 16px;
		padding: 1.5rem;
		transition: all 0.3s ease;
		border: 1px solid var(--soft-border);
	}

	.post-item:hover {
		background: var(--item-bg-hover);
		transform: translateX(8px);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
	}

	.post-link {
		text-decoration: none;
		display: block;
	}

	.post-item h3 {
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--text-primary); /* 回归深色，保持稳重 */
		margin: 0 0 0.75rem;
		transition: color 0.3s ease;
	}

	.post-item:hover h3 {
		color: var(--grad-end); /* 悬停时颜色深一点 */
	}

	.description {
		color: var(--text-body);
		font-size: 1rem;
		line-height: 1.8;
		margin: 0 0 1.25rem;
	}

	.date {
		font-size: 0.9rem;
		color: var(--text-secondary); /* 日期回归灰色 */
		font-weight: 500;
	}

	@media (max-width: 768px) {
		.page-header h1 { font-size: 2.2rem; }
		.category-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
		.post-item:hover { transform: translateY(-4px); }
	}

	/* ── 日志搜索 ── */
	.search-wrap {
		position: relative;
		max-width: 420px;
		margin: 2rem auto 0;
	}

	.search-icon {
		position: absolute;
		left: 0.9rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--text-muted);
		pointer-events: none;
	}

	.journal-search {
		width: 100%;
		padding: 0.7rem 1rem 0.7rem 2.6rem;
		font-size: 0.95rem;
		font-family: inherit;
		color: var(--text-primary);
		background: var(--soft-bg);
		border: 1px solid var(--soft-border);
		border-radius: 12px;
		outline: none;
		transition: all 0.2s ease;
		backdrop-filter: blur(6px);
	}

	.journal-search::placeholder { color: var(--text-muted); }

	.journal-search:focus {
		border-color: var(--grad-start);
		box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
	}

	.search-hint {
		font-size: 0.85rem;
		color: var(--text-muted);
		margin: 0.75rem 0 0;
		min-height: 1.2em;
	}

	/* 搜索态：被过滤隐藏的分类/文章 */
	.category-section.search-hidden,
	.post-item.search-hidden { display: none; }
</style>

<script is:inline>
	// 内联脚本被 VT 去重后不随换页重跑 → 注册 astro:after-swap 重挂
	function initJournalSearch() {
		const input = document.getElementById('journalSearch');
		if (!input || input.dataset.bound) return;
		input.dataset.bound = '1';

		const hint = document.getElementById('searchHint');
		const sections = Array.from(document.querySelectorAll('.category-section'));

		const runFilter = () => {
			const q = input.value.trim().toLowerCase();
			let total = 0;

			sections.forEach((section) => {
				let visible = 0;
				section.querySelectorAll('.post-item').forEach((item) => {
					const text = item.textContent.toLowerCase();
					const hit = !q || text.includes(q);
					item.classList.toggle('search-hidden', !hit);
					if (hit) visible++;
				});
				section.classList.toggle('search-hidden', q && visible === 0);
				total += visible;
			});

			if (hint) {
				hint.textContent = q
					? (total ? `找到 ${total} 篇相关日志` : '没有匹配的日志，换个关键词试试')
					: '';
			}
		};

		input.addEventListener('input', runFilter);
	}
	initJournalSearch();
	if (!window.__journalSearchHook) {
		window.__journalSearchHook = true;
		document.addEventListener('astro:after-swap', initJournalSearch);
	}
</script>
