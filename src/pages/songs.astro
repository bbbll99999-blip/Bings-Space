---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';

// 歌曲数据配置
// 若要置顶某首歌曲，请在该对象中添加 pinned: true 属性
const mySongs = [
	{ id: "--", title: "暂未上传", description: "旋律正在酝酿中...", date: "-----", audioUrl: "#", pinned: false }
];

// 排序逻辑：置顶优先，其次按日期倒序
const sortedSongs = [...mySongs].sort((a, b) => {
	if (a.pinned && !b.pinned) return -1;
	if (!a.pinned && b.pinned) return 1;
	return b.date.localeCompare(a.date);
});
---

<Layout title="一些翻唱 - Bing's Space" description="按上传时间顺序展示我录制的所有歌曲">
	<div class="container">
		<Navigation />

		<div class="page-header">
			<h1>一些翻唱</h1>
			<p>按时间顺序记录岁月里的每一段旋律</p>
		</div>

		<div class="songs-timeline glass-card">
			<div class="table-wrapper">
				<table class="song-table">
					<thead>
						<tr>
							<th class="col-id">#</th>
							<th class="col-main">作品详情</th>
							<th class="col-date">上传日期</th>
							<th class="col-player">试听</th>
						</tr>
					</thead>
					<tbody>
						{sortedSongs.map((song, index) => (
							<tr class={song.pinned ? 'pinned-row' : ''}>
								<td class="col-id">{(sortedSongs.length - index).toString().padStart(2, '0')}</td>
								<td class="col-main">
									<div class="info-cell">
										<div class="title-wrapper">
											<span class="name">{song.title}</span>
											{song.pinned && (
												<svg class="pinned-star" viewBox="0 0 24 24" fill="currentColor" title="置顶推荐">
													<path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
												</svg>
											)}
										</div>
										<span class="desc">{song.description}</span>
									</div>
								</td>
								<td class="col-date">{song.date}</td>
								<td class="col-player">
									<div class="player-cell">
										<audio controls>
											<source src={song.audioUrl} type="audio/mpeg" />
										</audio>
									</div>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</Layout>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	.page-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.page-header h1 {
		font-size: 3rem;
		font-weight: 800;
		margin: 0 0 1rem;
		background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.page-header p {
		font-size: 1.2rem;
		color: #64748b;
	}

	.songs-timeline {
		padding: 2rem;
		border-radius: 24px;
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(255, 255, 255, 0.5);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
	}

	.table-wrapper { width: 100%; overflow-x: auto; }
	.song-table { width: 100%; border-collapse: separate; border-spacing: 0; }

	th {
		padding: 1.5rem 1rem;
		text-align: left;
		color: #94a3b8;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 2px;
		border-bottom: 2px solid #f8fafc;
	}

	td {
		padding: 2rem 1rem;
		border-bottom: 1px solid #f1f5f9;
		vertical-align: middle;
	}

	tr:hover { background: #fafafa; }
	tr.pinned-row { background: rgba(99, 102, 241, 0.03); }

	.col-id { width: 5%; color: #cbd5e1; font-family: 'Courier New', monospace; font-size: 1.1rem; }
	.col-main { width: 50%; }
	.col-date { width: 20%; color: #64748b; font-size: 0.95rem; }
	.col-player { width: 25%; }

	.info-cell { display: flex; flex-direction: column; gap: 0.5rem; }
	.title-wrapper { display: flex; align-items: center; gap: 0.5rem; }
	.name { font-size: 1.3rem; font-weight: 700; color: #1e293b; }
	.pinned-star {
		width: 1.25rem;
		height: 1.25rem;
		color: #f59e0b; /* 温暖的金黄色 */
		flex-shrink: 0;
	}
	.desc { font-size: 0.95rem; color: #64748b; line-height: 1.5; }

	.player-cell audio { width: 100%; height: 36px; border-radius: 10px; }

	@media (max-width: 900px) {
		.col-date { display: none; }
		.col-main { width: 75%; }
	}
	@media (max-width: 600px) {
		th { display: none; }
		td { display: block; width: 100% !important; padding: 1rem 0; border: none; }
		tr { display: block; padding: 1.5rem 0; border-bottom: 1px solid #eee; }
	}
</style>
